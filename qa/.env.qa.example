# Copy to qa/.env.qa and fill in. Never commit qa/.env.qa.
# The agent only ever types the NAME (e.g. QA_USER_PASS); Playwright MCP substitutes the value
# and masks it in everything sent back to Copilot.
QA_USER_EMAIL=qa.user@example.com
QA_USER_PASS=change-me
# Local checkout used by /qa-learn and explicit automation smoke requests.
QA_AUTOMATION_PATH=/path/to/qa-automation
# QA_ADMIN_EMAIL=
# QA_ADMIN_PASS=
